{
  "actorSpecification": 1,
  "name": "japan-rent-market-scraper",
  "title": "Japan Rent Market — 3-Site Cross Comparison",
  "version": "0.1",
  "buildTag": "latest",
  "dockerfile": "./Dockerfile",
  "readme": "./README.md",
  "input": "./INPUT_SCHEMA.json",
  "outputSchema": {
    "actorOutputSchemaVersion": 1,
    "title": "Output",
    "description": "Property/Rent search results",
    "type": "object",
    "properties": {
      "title": {
        "title": "Title",
        "type": "string",
        "description": "Listing title",
        "template": "{{title}}"
      },
      "price": {
        "title": "Price",
        "type": "string",
        "description": "Price/rent in JPY",
        "template": "{{price}}"
      },
      "detailUrl": {
        "title": "Detail Url",
        "type": "string",
        "description": "Listing URL",
        "template": "{{detailUrl}}"
      },
      "shop": {
        "title": "Shop",
        "type": "string",
        "description": "Site name",
        "template": "{{shop}}"
      },
      "statsType": {
        "title": "Stats Type",
        "type": "string",
        "description": "Statistics mode",
        "template": "{{statsType}}"
      },
      "keyword": {
        "title": "Keyword",
        "type": "string",
        "description": "Search keyword",
        "template": "{{keyword}}"
      },
      "count": {
        "title": "Count",
        "type": "string",
        "description": "Result count (integer as string)",
        "template": "{{count}}"
      },
      "priceMin": {
        "title": "Price Min",
        "type": "string",
        "description": "Min price (integer as string, JPY)",
        "template": "{{priceMin}}"
      },
      "priceMax": {
        "title": "Price Max",
        "type": "string",
        "description": "Max price (integer as string, JPY)",
        "template": "{{priceMax}}"
      },
      "priceAvg": {
        "title": "Price Avg",
        "type": "string",
        "description": "Average price (number as string, JPY)",
        "template": "{{priceAvg}}"
      },
      "priceMedian": {
        "title": "Price Median",
        "type": "string",
        "description": "Median price (number as string, JPY)",
        "template": "{{priceMedian}}"
      },
      "sampleItems": {
        "title": "Sample Items",
        "type": "string",
        "description": "Sample items (JSON array as string)",
        "template": "{{sampleItems}}"
      },
      "collectedAt": {
        "title": "Collected At",
        "type": "string",
        "description": "Collect timestamp",
        "template": "{{collectedAt}}"
      }
    },
    "required": [
      "title",
      "price",
      "detailUrl"
    ]
  }
}
